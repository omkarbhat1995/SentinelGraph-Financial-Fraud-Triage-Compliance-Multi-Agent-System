# LLM Provider API Keys (at least one required; both recommended for automatic failover)
GOOGLE_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Default Model Identifiers
GEMINI_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-120b

# Database & Policy Paths
SQLITE_DB_PATH=data/fraud_triage.sqlite
AML_POLICY_PATH=data/aml_policy_rules.json

# Deterministic Scoring Thresholds
AUTO_CLOSE_MAX_SCORE=24
STEP_UP_MAX_SCORE=64
HIGH_AMOUNT_ZSCORE_THRESHOLD=3.0
VELOCITY_24H_THRESHOLD=5
IMPOSSIBLE_TRAVEL_KMH=800.0